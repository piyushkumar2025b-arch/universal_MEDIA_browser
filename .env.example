# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# URMIL Universal Retrieval Provider API Credentials (Optional - Graceful Fallbacks Included)
# Openverse
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
OPENVERSE_ACCESS_TOKEN=

# Pexels (Images & Videos)
PEXELS_API_KEY=

# Unsplash (High-Resolution Photography)
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# GIPHY (GIFs & Animated Media)
GIPHY_API_KEY=
TENOR_API_KEY=

# Pixabay
PIXABAY_API_KEY=

# GitHub (Code Search Rate Limits)
GITHUB_TOKEN=

# Freesound (Audio v2 & Sound Effects)
FREESOUND_API_KEY=

# Crossref (Scholarly Research Polite Pool)
CROSSREF_MAILTO="admin@example.com"
CROSSREF_API_KEY=

# NCBI / PubMed (Biomedical & Life Sciences Literature)
NCBI_API_KEY=
NCBI_EMAIL="researcher@example.com"
NCBI_TOOL="URMIL-Browser"

# Hugging Face Hub (Datasets & Open ML Models)
HF_TOKEN=

# NASA Open APIs (Earth, Mars, Astronomy APOD)
NASA_API_KEY=

# Europeana Cultural Heritage (50M+ items)
EUROPEANA_API_KEY=

# Smithsonian Institution Open Access Collections
SMITHSONIAN_API_KEY=

# Data.gov Official Federal Open Data Catalog (GSA Catalog v4 API)
DATAGOV_API_KEY=

# Google Services (Custom Search, YouTube Data v3, Google Books)
# A single Google API key with these 3 APIs enabled can power all of them!
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
YOUTUBE_API_KEY=
GOOGLE_BOOKS_API_KEY=

# Infrastructure & Storage
DATABASE_URL=
REDIS_URL=
STORAGE_PATH=./storage
LOG_LEVEL=INFO
